      "value": {
        "source": {
          "kind": "example.carried-values@1"
        },
        "binding": {
          "idempotent": "yes"
        }
      },
      "carrier": "binding",
      "schemaValid": false,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "wrong preference type refuses before work",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1"
        },
        "binding": {
          "preference": 0.5
        }
      },
      "carrier": "binding",
      "schemaValid": false,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "unknown unprefixed binding member refuses",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1"
        },
        "binding": {
