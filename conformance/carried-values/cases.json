      "schemaValid": true,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "source extension and null content survive for source-inspector",
      "interface": "source-inspector",
      "schema": "InspectSourceInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1",
          "content": null,
          "x-evidence": true
        }
      },
      "carrier": "source",
      "schemaValid": true,
      "allowedByCarriedValuesRule": true
    },
    {
      "description": "unknown source member refuses for interface-synthesizer",
      "interface": "interface-synthesizer",
      "schema": "SynthesizeInterfaceSource",
      "value": {
        "source": {
          "kind": "example.carried-values@1",
          "confidence": 1
        }
      },
      "carrier": "source",
      "schemaValid": true,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "source extension and null content survive for interface-synthesizer",
      "interface": "interface-synthesizer",
      "schema": "SynthesizeInterfaceSource",
      "value": {
        "source": {
          "kind": "example.carried-values@1",
          "content": null,
          "x-evidence": true
        }
      },
      "carrier": "source",
      "schemaValid": true,
      "allowedByCarriedValuesRule": true
    },
    {
      "description": "inspector producer binding {'confidence': 1}",
      "interface": "source-inspector",
      "schema": "BindableTarget",
      "value": {
        "sourceRef": "target",
        "binding": {
          "confidence": 1
        }
      },
      "carrier": "binding",
      "schemaValid": true,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "inspector producer binding {'operation': 'op'}",
      "interface": "source-inspector",
      "schema": "BindableTarget",
      "value": {
        "sourceRef": "target",
        "binding": {
          "operation": "op"
        }
      },
      "carrier": "binding",
      "schemaValid": true,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "inspector producer binding {'source': 's'}",
      "interface": "source-inspector",
      "schema": "BindableTarget",
      "value": {
        "sourceRef": "target",
        "binding": {
          "source": "s"
        }
      },
      "carrier": "binding",
      "schemaValid": true,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "inspector producer binding {'content': None, 'x-evidence': True}",
      "interface": "source-inspector",
      "schema": "BindableTarget",
      "value": {
        "sourceRef": "target",
        "binding": {
          "content": null,
          "x-evidence": true
        }
      },
      "carrier": "binding",
      "schemaValid": true,
      "allowedByCarriedValuesRule": true
    }
  ]
}
