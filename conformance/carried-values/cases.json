{
  "format": "openbindings.carried-values-cases@1",
  "description": "Contract schemas remain open for x- extensions within the comparison profile. allowedByCarriedValuesRule separately records the normative refusal rule; this corpus is not a runtime conformance claim.",
  "tests": [
    {
      "description": "legacy binding selector refuses before work",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1"
        },
        "binding": {
          "selector": "deploy"
        }
      },
      "carrier": "binding",
      "schemaValid": true,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "legacy source location refuses before work",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1",
          "location": "file:///x"
        },
        "binding": {}
      },
      "carrier": "source",
      "schemaValid": true,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "legacy bindingSpec source member refuses before work",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1",
          "bindingSpec": "k"
        },
        "binding": {}
      },
      "carrier": "source",
      "schemaValid": true,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "extensions survive the full binding carrier",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1"
        },
        "binding": {
          "operation": "op",
          "source": "s",
          "x-target": "keep"
        }
      },
      "carrier": "binding",
      "schemaValid": true,
      "allowedByCarriedValuesRule": true
    },
    {
      "description": "explicit null content is carried",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1"
        },
        "binding": {
          "content": null
        }
      },
      "carrier": "binding",
      "schemaValid": true,
      "allowedByCarriedValuesRule": true
    },
    {
      "description": "absent content is carried as empty binding",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1"
        },
        "binding": {}
      },
      "carrier": "binding",
      "schemaValid": true,
      "allowedByCarriedValuesRule": true
    },
    {
      "description": "wrong typed binding member is refused",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1"
        },
        "binding": {
          "operation": 1
        }
      },
      "carrier": "binding",
      "schemaValid": false,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "missing binding refuses the whole input before work",
      "interface": "binding-invoker",
      "schema": "BindingInvocationInput",
      "value": {
        "source": {
          "kind": "example.carried-values@1"
        }
      },
      "carrier": "binding",
      "schemaValid": false,
      "allowedByCarriedValuesRule": false
    },
    {
      "description": "top-level legacy selector refuses before work",
      "interface": "binding-invoker",
