{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/interfaces/conformance/pull-report/fixture.schema.json",
  "title": "Source Puller Output Shape Examples",
  "type": "object",
  "required": [
    "format",
    "tests"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "openbindings.source-pull-report-cases@1"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "description",
          "interface",
          "source",
          "additions",
          "report",
          "schemaValid"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "interface": {
            "type": "object",
            "description": "The pull's input document."
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "The key of the sources entry pulled."
          },
          "additions": {
            "type": "object",
            "description": "The result's additions to interface. Inserting them into interface gives the pulled document."
          },
          "report": {
            "type": "object",
            "description": "The result's report."
          },
          "schemaValid": {
            "type": "boolean"
          },
          "completePull": {
            "type": "boolean",
            "description": "Whether a schema-valid report meets the guide's complete-pull condition: exhaustive is true and no omitted entry is implementation-unsupported. Absent when schemaValid is false."
          }
        },
        "if": {
          "properties": {
            "schemaValid": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "completePull"
          ]
        },
        "else": {
          "not": {
            "required": [
              "completePull"
            ]
          }
        }
      }
    }
  }
}
