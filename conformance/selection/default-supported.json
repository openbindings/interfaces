{
  "cluster": "default-supported",
  "description": "Candidate-set formation: the candidate set is the operation's bindings whose kinds the invoker can act on, by exact identifier. Unsupported bindings are excluded before sole-candidate or ambiguity resolution; no invocable binding fails with ERR_BINDING_NOT_FOUND.",
  "tests": [
    {
      "description": "an unsupported binding is skipped, leaving the supported binding as the sole candidate",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "bindings": {
          "getThing.rest": {
            "operation": "getThing",
            "kind": "example.openapi@1",
            "content": {
              "selector": "#/paths/~1things~1{id}/get"
            },
            "preference": 1
          },
          "getThing.rpc": {
            "operation": "getThing",
            "kind": "example.grpc@1",
            "content": {
              "selector": "things.v1.Things/GetThing"
            },
            "preference": 100
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1"
      ],
      "expected": {
        "binding": "getThing.rest"
      }
    },
    {
      "description": "the sole candidate's kind is unsupported: no invocable candidate exists",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "bindings": {
          "getThing.rpc": {
            "operation": "getThing",
            "kind": "example.grpc@1",
            "content": {
              "selector": "things.v1.Things/GetThing"
            }
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1"
      ],
      "expected": {
        "error": true,
        "kind": "no-candidate"
      }
    },
    {
      "description": "the document declares no bindings at all: the candidate set is empty",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1"
      ],
      "expected": {
        "error": true,
        "kind": "no-candidate"
      }
    },
    {
      "description": "bindings exist but none targets the addressed operation: another operation's bindings are never candidates",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {},
          "listThings": {}
        },
        "bindings": {
          "listThings.rest": {
            "operation": "listThings",
            "kind": "example.openapi@1",
            "content": {
              "selector": "#/paths/~1things/get"
            },
            "preference": 100
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1"
      ],
      "expected": {
        "error": true,
        "kind": "no-candidate"
      }
    },
    {
      "description": "candidate filtering leaves a deprecated supported binding as the sole invocable candidate",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "bindings": {
          "getThing.rest": {
            "operation": "getThing",
            "kind": "example.openapi@1",
            "content": {
              "selector": "#/paths/~1things~1{id}/get"
            },
            "deprecated": true
          },
          "getThing.rpc": {
            "operation": "getThing",
            "kind": "example.grpc@1",
            "content": {
              "selector": "things.v1.Things/GetThing"
            },
            "preference": 100
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1"
      ],
      "expected": {
        "binding": "getThing.rest"
      }
    }
  ]
}
