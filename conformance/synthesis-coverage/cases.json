{
  "format": "openbindings.interface-synthesis-coverage-cases@1",
  "tests": [
    {
      "description": "complete represented evidence links input source, emitted source, binding, operation, and selector",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {
          "getUser": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi@1",
            "location": "https://example.com/openapi.json"
          }
        },
        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "source": "api",
            "selector": "#/paths/~1users~1{id}/get"
          }
        }
      },
      "entries": [
        {
          "sourceIndex": 0,
          "sourceKey": "api",
          "sourceRef": "#/paths/~1users~1{id}/get",
          "scope": "target",
          "status": "represented",
          "operationKey": "getUser",
          "bindingKey": "getUser.api",
          "bindingSelector": "#/paths/~1users~1{id}/get"
        }
      ],
      "exhaustive": true,
      "expected": {
        "valid": true,
        "fullyRepresented": true
      }
    },
    {
      "description": "an exhaustive binding-specification exclusion is honest but not fully represented",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi@1",
            "location": "https://example.com/openapi.json"
          }
        }
      },
      "entries": [
        {
          "sourceIndex": 0,
          "sourceRef": "#/webhooks/onEvent/post",
          "scope": "target",
          "status": "excluded",
          "reasonCode": "openapi.reverse_direction",
          "rule": "OAPI-D-03",
          "message": "reverse-direction interaction is outside this binding revision"
        }
      ],
      "exhaustive": true,
      "expected": {
        "valid": true,
        "fullyRepresented": false
      }
    },
    {
      "description": "non-exhaustive evidence can never claim full representation",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {
          "getUser": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi@1",
            "location": "https://example.com/openapi.json"
          }
        },
        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "source": "api",
            "selector": "#/paths/~1users~1{id}/get"
          }
        }
      },
      "entries": [
        {
          "sourceIndex": 0,
          "sourceKey": "api",
          "sourceRef": "#/paths/~1users~1{id}/get",
          "scope": "target",
          "status": "represented",
          "operationKey": "getUser",
          "bindingKey": "getUser.api",
          "bindingSelector": "#/paths/~1users~1{id}/get"
        }
      ],
      "exhaustive": false,
      "expected": {
        "valid": true,
        "fullyRepresented": false
      }
    },
    {
      "description": "represented evidence is rejected when its binding key names no emitted binding",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {
          "getUser": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi@1",
            "location": "https://example.com/openapi.json"
          }
        },
        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "source": "api",
            "selector": "#/paths/~1users~1{id}/get"
          }
        }
      },
      "entries": [
        {
          "sourceIndex": 0,
          "sourceKey": "api",
          "sourceRef": "#/paths/~1users~1{id}/get",
          "scope": "target",
          "status": "represented",
          "operationKey": "getUser",
          "bindingKey": "getUser.missing",
          "bindingSelector": "#/paths/~1users~1{id}/get"
        }
      ],
      "exhaustive": true,
      "expected": {
        "valid": false,
        "errorContains": "no matching binding"
      }
    },
    {
      "description": "lossy evidence must identify the represented path whose projection is incomplete",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {
          "getUser": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi@1",
            "location": "https://example.com/openapi.json"
          }
        },
        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "source": "api",
            "selector": "#/paths/~1users~1{id}/get"
          }
        }
      },
      "entries": [
        {
          "sourceIndex": 0,
          "sourceRef": "#/paths/~1users~1{id}/get::projection::response",
          "scope": "projection",
          "status": "lossy",
          "reasonCode": "openapi.schema_projection",
          "message": "one upstream schema constraint has no exact OBI projection"
        }
      ],
      "exhaustive": true,
      "expected": {
        "valid": false,
        "errorContains": "requires operationKey"
      }
    },
    {
      "description": "a dependency unit an exclusion removed keeps dependency scope and carries the reason",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {
          "createJob": {},
          "onJobDone": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-3.1@1",
            "location": "https://example.com/openapi.json"
          }
        },
        "bindings": {
          "createJob.api": {
            "operation": "createJob",
            "source": "api",
            "selector": "#/paths/~1jobs/post"
          }
        },
        "dependencies": {
          "jobDone": {
            "operation": "onJobDone"
          }
        }
      },
      "entries": [
        {
          "sourceIndex": 0,
          "sourceKey": "api",
          "sourceRef": "#/paths/~1jobs/post",
          "scope": "target",
          "status": "represented",
          "operationKey": "createJob",
          "bindingKey": "createJob.api",
          "bindingSelector": "#/paths/~1jobs/post"
        },
        {
          "sourceIndex": 0,
          "sourceRef": "#/paths/~1jobs/post/callbacks/done/{$request.body#~1url}/post",
          "scope": "dependency",
          "status": "represented"
        },
        {
          "sourceIndex": 0,
          "sourceRef": "#/webhooks/jobFailed/post",
          "scope": "dependency",
          "status": "excluded",
          "reasonCode": "openapi.inbound_dependency_excluded",
          "message": "the inbound operation declares no resolvable request contract"
        }
      ],
      "exhaustive": true,
      "expected": {
        "valid": true,
        "fullyRepresented": false
      }
    },
    {
      "description": "a represented dependency entry carrying emitted binding identity is rejected",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {
          "createJob": {},
          "onJobDone": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-3.1@1",
            "location": "https://example.com/openapi.json"
          }
        },
        "bindings": {
          "createJob.api": {
            "operation": "createJob",
            "source": "api",
            "selector": "#/paths/~1jobs/post"
          }
        },
        "dependencies": {
          "jobDone": {
            "operation": "onJobDone"
          }
        }
      },
      "entries": [
        {
          "sourceIndex": 0,
          "sourceKey": "api",
          "sourceRef": "#/paths/~1jobs/post",
          "scope": "target",
          "status": "represented",
          "operationKey": "createJob",
          "bindingKey": "createJob.api",
          "bindingSelector": "#/paths/~1jobs/post"
        },
        {
          "sourceIndex": 0,
          "sourceRef": "#/paths/~1jobs/post/callbacks/done/{$request.body#~1url}/post",
          "scope": "dependency",
          "status": "represented",
          "operationKey": "onJobDone",
          "bindingKey": "createJob.api",
          "bindingSelector": "#/paths/~1jobs/post"
        }
      ],
      "exhaustive": true,
      "expected": {
        "valid": false,
        "errorContains": "must not carry operation or binding identity"
      }
    },
    {
      "description": "an emitted dependency with no represented dependency entry is rejected",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {
          "createJob": {},
          "onJobDone": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-3.1@1",
            "location": "https://example.com/openapi.json"
          }
        },
        "bindings": {
          "createJob.api": {
            "operation": "createJob",
            "source": "api",
            "selector": "#/paths/~1jobs/post"
          }
        },
        "dependencies": {
          "jobDone": {
            "operation": "onJobDone"
          }
        }
      },
      "entries": [
        {
          "sourceIndex": 0,
          "sourceKey": "api",
          "sourceRef": "#/paths/~1jobs/post",
          "scope": "target",
          "status": "represented",
          "operationKey": "createJob",
          "bindingKey": "createJob.api",
          "bindingSelector": "#/paths/~1jobs/post"
        }
      ],
      "exhaustive": true,
      "expected": {
        "valid": false,
        "errorContains": "for 1 emitted dependencies"
      }
    }
  ]
}
