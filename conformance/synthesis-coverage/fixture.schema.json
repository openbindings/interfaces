{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/interfaces/conformance/synthesis-coverage/fixture.schema.json",
  "title": "Interface Synthesizer Output Shape Examples",
  "type": "object",
  "required": [
    "format",
    "tests"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "openbindings.interface-synthesis-shape-cases@1"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "description",
          "interface",
          "report",
          "schemaValid"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "interface": {
            "type": "object"
          },
          "report": {
            "type": "object"
          },
          "schemaValid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
