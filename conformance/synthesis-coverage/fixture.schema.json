{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/interfaces/conformance/synthesis-coverage/fixture.schema.json",
  "title": "Interface Synthesizer Output Shape Examples",
  "type": "object",
  "required": [
    "format",
    "tests"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "openbindings.interface-synthesis-shape-cases@1"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "description",
          "interface",
          "report",
          "schemaValid"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "interface": {
            "type": "object"
          },
          "report": {
            "type": "object"
          },
          "schemaValid": {
            "type": "boolean"
          },
          "completeSynthesis": {
            "type": "boolean",
            "description": "Whether a schema-valid report meets the guide's complete-synthesis condition: exhaustive is true and no entry is implementation-unsupported. Absent when schemaValid is false."
          }
        },
        "if": {
          "properties": {
            "schemaValid": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "completeSynthesis"
          ]
        },
        "else": {
          "not": {
            "required": [
              "completeSynthesis"
            ]
          }
        }
      }
    }
  }
}
