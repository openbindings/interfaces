            }
          }
        ]
      },
      "schemaValid": true,
      "completeSynthesis": false
    },
    {
      "description": "A non-exhaustive report does not meet complete synthesis, and an unmatched binding may correspond to something unread",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {
          "getLegacy": {}
        },
        "bindings": {
          "getLegacy.api": {
            "operation": "getLegacy",
            "kind": "example.report@1",
            "content": {
