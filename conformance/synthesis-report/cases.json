    {
      "description": "Kind-defined exclusions and invalid parts still meet complete synthesis",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {},
        "resources": {
          "api": {
            "location": "https://example.com/openapi.json"
          }
        }
      },
      "additions": {
        "operations": {
          "getUser": {}
        },
        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "kind": "example.report@1",
            "content": {
              "resource": "api",
              "selector": "#/paths/~1users~1{id}/get"
            }
          }
        }
      },
      "report": {
        "exhaustive": true,
        "added": [
          {
            "binding": "getUser.api",
            "operation": "getUser"
          }
        ],
        "omitted": [
          {
            "status": "excluded",
            "reasonCode": "example.probe-excluded",
            "message": "The kind does not admit health probes.",
            "rule": "example.report@1 section 3",
            "details": {
              "path": "/health",
              "method": "get"
            }
          },
          {
            "status": "invalid",
            "reasonCode": "example.contradictory-body",
            "message": "The source declares contradictory request bodies.",
            "details": {
              "path": "/users",
              "method": "post"
            }
          }
        ]
      },
      "schemaValid": true,
      "completeSynthesis": true
    },
    {
      "description": "An implementation gap does not meet complete synthesis",
