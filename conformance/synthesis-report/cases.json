        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "kind": "example.report@1",
            "content": {
              "resource": "api",
              "selector": "#/paths/~1users~1{id}/get"
            }
          }
        }
      },
      "report": {
        "exhaustive": false,
        "limitation": {
          "code": "example.unread-reference",
          "message": "An external reference was not read, so further paths may exist."
        },
        "added": [
          {
            "binding": "getUser.api",
            "operation": "getUser"
          }
        ],
        "existing": [
          {
            "binding": "getLegacy.api",
            "status": "unmatched"
          }
        ]
      },
      "schemaValid": true,
      "completeSynthesis": false
    },
