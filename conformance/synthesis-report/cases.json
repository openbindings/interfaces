{
  "format": "openbindings.interface-synthesis-report-cases@1",
  "tests": [
    {
      "description": "A minimal result",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {}
      },
      "additions": {},
      "report": {
        "exhaustive": true,
        "added": []
      },
      "schemaValid": true,
      "completeSynthesis": true
    },
    {
      "description": "An added binding names its operation and every addition it uses, directly or through another",
      "interface": {
        "openbindings": "0.2.0",
        "schemas": {
          "UserId": {
            "type": "string"
          }
        },
        "operations": {},
        "resources": {
          "api": {
            "location": "https://example.com/openapi.json"
          }
        }
      },
      "additions": {
        "schemas": {
          "User": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "address": {
                "$ref": "#/schemas/Address"
              }
            }
          },
          "Address": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "getUser": {
            "input": {
              "$ref": "#/schemas/UserId"
            },
            "output": {
              "$ref": "#/schemas/User"
            }
          }
        },
        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "kind": "example.report@1",
            "content": {
              "resource": "api",
              "selector": "#/paths/~1users~1{id}/get"
            }
          }
        }
      },
      "report": {
        "exhaustive": true,
        "added": [
          {
            "binding": "getUser.api",
            "operation": "getUser",
            "uses": {
              "schemas": [
                "User",
                "Address"
              ]
            },
            "requirements": [
              "example.api-key"
            ]
          }
        ]
      },
      "schemaValid": true,
      "completeSynthesis": true
    },
    {
      "description": "An added dependency names the operation it consumes",
      "interface": {
        "openbindings": "0.2.0",
        "operations": {},
        "resources": {
          "api": {
            "location": "https://example.com/openapi.json"
          }
        }
      },
      "additions": {
        "schemas": {
          "Job": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createJob": {
            "output": {
              "$ref": "#/schemas/Job"
            }
          },
          "onJobDone": {
            "input": {
              "$ref": "#/schemas/Job"
            }
          }
        },
        "dependencies": {
          "jobDone": {
            "operation": "onJobDone"
          }
        },
        "bindings": {
          "createJob.api": {
            "operation": "createJob",
            "kind": "example.report@1",
            "content": {
              "resource": "api",
              "selector": "#/paths/~1jobs/post"
            }
          }
        }
      },
      "report": {
        "exhaustive": true,
        "added": [
          {
            "binding": "createJob.api",
            "operation": "createJob",
            "uses": {
              "schemas": [
                "Job"
              ]
            }
          },
          {
            "dependency": "jobDone",
            "operation": "onJobDone",
            "uses": {
              "schemas": [
                "Job"
              ]
            }
          }
        ]
      },
      "schemaValid": true,
      "completeSynthesis": true
    },
